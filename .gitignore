# ============================================================
# RESTRICTED / LICENSED PFF DATA -- never commit
# ============================================================
# The PFF FC match data (event JSONs, tracking JSONL, per-event player/ball
# CSVs and any derivative of them) is licensed and must not be redistributed.
# See docs/data_access.md and data/README.md.
data/pff_match_data/*
!data/pff_match_data/.gitkeep

# Derived pass tables are built from PFF tracking data and are also large;
# regenerate them with scripts/build_worldcup_passes_csv.py instead.
data/derived/*
!data/derived/.gitkeep
# defense in depth: any curvature-enriched pass table embeds raw PFF trajectories
passes_with_curvature.csv
*passes_with_curvature.csv

# Raw tracking / event data anywhere in the tree (defense in depth)
*.jsonl
*-tracking.jsonl
# per-event player/ball exports and event JSONs at typical PFF names,
# wherever they might accidentally appear
match_*_players.csv
match_*_ball.csv

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ============================================================
# Notebooks / editors / OS
# ============================================================
.ipynb_checkpoints/
.vs/
.vscode/
.idea/
Thumbs.db
.DS_Store
